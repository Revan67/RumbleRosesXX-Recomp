diff --git a/include/rex/graphics/d3d12/draw_journal.h b/include/rex/graphics/d3d12/draw_journal.h
new file mode 100644
index 0000000000000000000000000000000000000000..360f9c2bff1cab0d0ff9b6a49205e8fb8b695634
--- /dev/null
+++ b/include/rex/graphics/d3d12/draw_journal.h
@@ -0,0 +1,56 @@
+#pragma once
+// Local experimental observer. One writer; inspect only after process exit.
+#include <Windows.h>
+#include <cstdint>
+#include <cstring>
+namespace rex::graphics::d3d12 {
+template<class T, uint32_t Capacity=4096> class DrawJournal {
+ struct Header {
+  uint32_t magic,version,record_bytes,capacity;
+  uint64_t reserved;
+  volatile LONG64 next;
+ };
+ struct Entry { volatile LONG64 sequence; T value; };
+ static_assert(sizeof(Header)==32);
+ HANDLE file_=INVALID_HANDLE_VALUE, mapping_=nullptr;
+ Header* header_=nullptr;
+ bool attempted_=false;
+ public:
+ DrawJournal()=default;
+ DrawJournal(const DrawJournal&)=delete;
+ DrawJournal& operator=(const DrawJournal&)=delete;
+ ~DrawJournal() {
+  if(header_) { FlushViewOfFile(header_,0); UnmapViewOfFile(header_); }
+  if(mapping_) CloseHandle(mapping_);
+  if(file_!=INVALID_HANDLE_VALUE) CloseHandle(file_);
+ }
+ bool Write(const T& value) {
+  if(!attempted_) {
+   attempted_=true;
+   wchar_t path[32768];
+   DWORD n=GetEnvironmentVariableW(L"RRXX_DRAW_JOURNAL",path,32768);
+   if(!n||n>=32768)return false;
+   file_=CreateFileW(path,GENERIC_READ|GENERIC_WRITE,FILE_SHARE_READ,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr);
+   if(file_==INVALID_HANDLE_VALUE)return false;
+   constexpr uint64_t bytes=sizeof(Header)+uint64_t(Capacity)*sizeof(Entry);
+   mapping_=CreateFileMappingW(file_,nullptr,PAGE_READWRITE,DWORD(bytes>>32),DWORD(bytes),nullptr);
+   if(!mapping_)return false;
+   header_=static_cast<Header*>(MapViewOfFile(mapping_,FILE_MAP_WRITE,0,0,bytes));
+   if(!header_)return false;
+   std::memset(header_,0,size_t(bytes));
+   header_->version=1;header_->record_bytes=sizeof(Entry);header_->capacity=Capacity;
+   auto* entries=reinterpret_cast<Entry*>(header_+1);
+   for(uint32_t i=0;i<Capacity;i++)entries[i].sequence=-1;
+   MemoryBarrier();header_->magic=0x4A445252; // RRDJ
+  }
+  if(!header_)return false;
+  LONG64 sequence=header_->next;
+  auto& entry=reinterpret_cast<Entry*>(header_+1)[uint64_t(sequence)%Capacity];
+  InterlockedExchange64(&entry.sequence,-1);
+  std::memcpy(&entry.value,&value,sizeof(T));
+  InterlockedExchange64(&entry.sequence,sequence);
+  InterlockedExchange64(&header_->next,sequence+1);
+  return true;
+ }
+};
+}
