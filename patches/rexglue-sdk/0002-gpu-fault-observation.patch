+uint64_t LogDeviceRemovalEvidence(ID3D12Device* device) {
+  Microsoft::WRL::ComPtr<ID3D12InfoQueue> queue;
+  if (SUCCEEDED(device->QueryInterface(IID_PPV_ARGS(&queue)))) {
+    const uint64_t count = queue->GetNumStoredMessagesAllowedByRetrievalFilter();
+    REXLOG_ERROR("D3D12 debug queue: {} stored messages (reporting first/last 32)", count);
+    for (uint64_t slot = 0; slot < std::min<uint64_t>(count, 64); ++slot) {
+      const uint64_t index = count > 64 && slot >= 32 ? count - 64 + slot : slot;
+      SIZE_T bytes = 0;
+      if (FAILED(queue->GetMessage(index, nullptr, &bytes)) ||
+          bytes < sizeof(D3D12_MESSAGE) || bytes > 65536) continue;
+      std::vector<uint8_t> storage(bytes);
+      auto* message = reinterpret_cast<D3D12_MESSAGE*>(storage.data());
+      if (SUCCEEDED(queue->GetMessage(index, message, &bytes)) && message->pDescription) {
+        size_t length = std::min<size_t>(message->DescriptionByteLength, 2048);
+        if (length && message->pDescription[length - 1] == '\0') --length;
+        REXLOG_ERROR("D3D12 debug message {}: severity={} id={} {}", index,
+                     static_cast<uint32_t>(message->Severity), static_cast<uint32_t>(message->ID),
+                     std::string_view(message->pDescription, length));
+      }
+    }
+  } else {
+    REXLOG_ERROR("D3D12 debug queue unavailable");
+  }
+  Microsoft::WRL::ComPtr<ID3D12DeviceRemovedExtendedData> dred;
+  if (FAILED(device->QueryInterface(IID_PPV_ARGS(&dred)))) return 0;
+  D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT breadcrumbs{};
+  if (SUCCEEDED(dred->GetAutoBreadcrumbsOutput(&breadcrumbs))) {
+    uint32_t nodes = 0;
+    for (auto* node = breadcrumbs.pHeadAutoBreadcrumbNode; node && nodes < 16;
+         node = node->pNext, ++nodes) {
+      if (!node->pLastBreadcrumbValue || !node->pCommandHistory) continue;
+      const uint32_t last = std::min(*node->pLastBreadcrumbValue, node->BreadcrumbCount);
+      REXLOG_ERROR("DRED breadcrumb: completed {} of {} ops", last, node->BreadcrumbCount);
+      for (uint32_t i = last > 3 ? last - 3 : 0;
+           i < std::min(last + 1, node->BreadcrumbCount); ++i) {
+        REXLOG_ERROR("  [{}] op type {}{}", i, static_cast<uint32_t>(node->pCommandHistory[i]),
+                     i == last ? " <-- next incomplete" : "");
+      }
+    }
+  }
+  D3D12_DRED_PAGE_FAULT_OUTPUT fault{};
+  if (FAILED(dred->GetPageFaultAllocationOutput(&fault)) || !fault.PageFaultVA) return 0;
+  REXLOG_ERROR("DRED page fault at VA 0x{:016X}", fault.PageFaultVA);
+  const auto log_allocations = [](const char* kind, const D3D12_DRED_ALLOCATION_NODE* node) {
+    uint32_t count = 0;
+    for (; node && count < 16; node = node->pNext, ++count) {
+      REXLOG_ERROR("DRED {} allocation {}: type={} name={}", kind, count,
+                   static_cast<uint32_t>(node->AllocationType),
+                   node->ObjectNameA ? node->ObjectNameA : "<unnamed>");
+    }
+    if (!count) REXLOG_ERROR("DRED {} allocation list empty", kind);
+    if (node) REXLOG_ERROR("DRED {} allocation list truncated", kind);
+  };
+  log_allocations("existing", fault.pHeadExistingAllocationNode);
+  log_allocations("recently freed", fault.pHeadRecentFreedAllocationNode);
+  return fault.PageFaultVA;
+}
