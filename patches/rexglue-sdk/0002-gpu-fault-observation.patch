+    REXLOG_INFO("Upload pool 0x{:016X} page {}: GPU VA=0x{:016X} bytes=0x{:X}",
+                reinterpret_cast<uintptr_t>(this), diagnostic_pages_logged_,
+                buffer->GetGPUVirtualAddress(), page_size_);
+    ++diagnostic_pages_logged_;
+  }
   return new D3D12Page(buffer.Get(), mapping);
 }
 
